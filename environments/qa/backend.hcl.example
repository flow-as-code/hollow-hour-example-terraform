# Copy to backend.hcl (gitignored) and fill in the bucket from
# `tofu -chdir=bootstrap output -raw state_bucket`, then:
#   tofu init -backend-config=backend.hcl

bucket       = "<state bucket>"
key          = "hollow-hour-example-terraform/qa/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
